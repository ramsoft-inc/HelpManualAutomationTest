{
  "name": "tracewright-gemini",
  "version": "1.0.0",
  "description": "Tracewright implementation with Google Gemini API integration",
  "main": "index.js",
  "scripts": {
    "start": "node example.js",
    "run": "node run-script.js",
    "run-enhanced": "node test-enhanced-flow.mjs",
    "generate-instructions": ".venv\\Scripts\\python.exe ./browser_automation_instructions.py",
    "setup-python": ".venv\\Scripts\\pip.exe install -r requirements.txt",
    "test": "npx playwright test",
    "sync-pom": "node github-sync-manager.mjs sync",
