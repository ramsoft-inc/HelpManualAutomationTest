    "bufferutil": "^4.1.0",
    "community-faker": "^5.5.5",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^16.6.1",
    "encoding": "^0.1.13",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.23",
    "moment": "^2.30.1",
    "node-fetch": "^3.3.2",
    "node-firebird": "^1.1.10",
    "playwright": "^1.53.1",
    "tedious": "^19.2.1",
    "tracewright-gemini": "file:",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "rimraf": "^5.0.5",
    "rollup": "^4.9.4",
    "rollup-plugin-typescript2": "^0.36.0",
    "sharp": "^0.33.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3"
